<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.ShoppingManagementView"
             Title="ShoppingManagementView">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Scrollable Store + Cart -->
			<RowDefinition Height="Auto"/>
			<!-- Tax + Checkout Buttons -->
		</Grid.RowDefinitions>

		<!-- STORE + CART SECTION -->
		<ScrollView Grid.Row="0" Orientation="Vertical">
			<HorizontalStackLayout Padding="10" Spacing="20">

				<!-- STORE (Inventory List) -->
				<VerticalStackLayout WidthRequest="400" Spacing="10">
					<Label Text="Store Inventory" FontAttributes="Bold" FontSize="20"/>

					<!-- Sort Picker -->
					<Picker Title="Sort By"
                            SelectedItem="{Binding SortBy}"
                            Margin="0,0,0,10">
						<Picker.ItemsSource>
							<x:Array Type="{x:Type x:String}">
								<x:String>Name</x:String>
								<x:String>Price</x:String>
							</x:Array>
						</Picker.ItemsSource>
					</Picker>

					<!-- Store Inventory List -->
					<ListView ItemsSource="{Binding Inventory}"
                              SelectedItem="{Binding SelectedItem}"
                              HeightRequest="400">
						<ListView.ItemTemplate>
							<DataTemplate>
								<ViewCell>
									<Grid Padding="5">
										<Grid.ColumnDefinitions>
											<ColumnDefinition />
											<!-- ID -->
											<ColumnDefinition Width="5*" />
											<!-- Name -->
											<ColumnDefinition />
											<!-- x -->
											<ColumnDefinition />
											<!-- Quantity -->
											<ColumnDefinition Width="Auto"/>
											<!-- Price -->
											<ColumnDefinition Width="Auto"/>
											<!-- Entry -->
											<ColumnDefinition Width="Auto"/>
											<!-- Add Button -->
										</Grid.ColumnDefinitions>

										<Label Grid.Column="0" Text="{Binding Id}" />
										<Label Grid.Column="1" Text="{Binding Product.Name}" />
										<Label Grid.Column="2" Text="x" />
										<Label Grid.Column="3" Text="{Binding Quantity}" />

										<!-- Price -->
										<Label Grid.Column="4"
                                               Text="{Binding Product.Price, StringFormat='${0:F2}'}"
                                               TextColor="DarkGreen"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />

										<!-- Quantity Entry -->
										<Entry Grid.Column="5"
                                               Text="{Binding AddQuantity}"
                                               WidthRequest="50"
                                               Keyboard="Numeric"
                                               VerticalOptions="Center"/>

										<!-- + Button -->
										<Button Grid.Column="6"
                                                Text="+"
                                                Clicked="InlineAddClicked"
                                                VerticalOptions="Center"/>
									</Grid>
								</ViewCell>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>

					<!-- Optional: Global add button -->
					<Button Text="+" Clicked="AddToCartClicked"/>
				</VerticalStackLayout>

				<!-- SHOPPING CART -->
				<VerticalStackLayout WidthRequest="350" Spacing="10">
					<Label Text="Shopping Cart" FontAttributes="Bold" FontSize="20"/>
					<ListView ItemsSource="{Binding ShoppingCart}"
                              SelectedItem="{Binding SelectedCartItem}"
                              HeightRequest="400"/>
					<Button Text="–" Clicked="RemoveFromCartClicked"/>
				</VerticalStackLayout>

			</HorizontalStackLayout>
		</ScrollView>

		<!-- TAX + CHECKOUT BUTTONS -->
		<HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="10">
			<Button Text="Configure Tax Rate"
                    Clicked="OnConfigureTaxClicked"
                    HorizontalOptions="StartAndExpand"/>

			<Button Text="Checkout"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnCheckoutClicked"
                    HorizontalOptions="EndAndExpand"/>
		</HorizontalStackLayout>
	</Grid>

</ContentPage>
